# ─── Required ─────────────────────────────────────────────
# Supabase project (Dashboard → Project Settings → API). The anon/publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used for auth redirects, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Server-only secrets (never prefix with NEXT_PUBLIC_) ─
# Used only to look up a listing owner's email for inquiry notifications.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: email notifications via Resend (https://resend.com). Leave empty to disable.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=סולגג <no-reply@example.com>
# Optional: Google Geocoding API for Hebrew address search. Empty = OpenStreetMap Nominatim (low volume only).
GOOGLE_MAPS_API_KEY=

# ─── Maps (defaults are fine for development, NOT for production traffic) ─
# Street map tiles, e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Aerial imagery tiles, e.g. MapTiler satellite or a licensed orthophoto service
NEXT_PUBLIC_IMAGERY_TILE_URL=
NEXT_PUBLIC_IMAGERY_TILE_ATTRIBUTION=

# ─── Auth ─────────────────────────────────────────────────
# Set to true only after configuring an SMS provider in Supabase Auth (Twilio, MessageBird, Vonage…)
NEXT_PUBLIC_AUTH_PHONE_ENABLED=false
